# Leave unset for local dev (uses local.db via SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# bcrypt hash of the admin password (generate with: npm run admin:hash -- "yourpassword")
# IMPORTANT: escape every "$" as "\$" here, otherwise Next.js's env loader
# tries to expand "$2b", "$10", etc. as variable references and mangles the hash.
ADMIN_PASSWORD_HASH=

# random long string used to sign the admin session cookie
SESSION_SECRET=
